# ------------------------------------------------------------------
# Papo Reto Ranking — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre na Vercel (produção).
# Sem as variáveis do Supabase o site roda em MODO DEMONSTRAÇÃO
# (participantes provisórios e números simulados, claramente identificados).
# ------------------------------------------------------------------

# Domínio do site no servidor (Caddy gera o HTTPS sozinho). Vazio = responde pelo IP, sem HTTPS.
SITE_DOMAIN=

# URL pública do site, sem barra no final (canonical, Open Graph, sitemap e links compartilhados).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon": usada só no navegador para o Realtime (leitura do placar, protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role": SOMENTE no servidor. Nunca use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=

# --- Votação ---
# Libera os botões de voto. Sem "true", o clique mostra "Segura a corneta! Logo, logo você vai poder votar!".
NEXT_PUBLIC_VOTING_OPEN=false
# Segredo para assinar o cookie do votante e gerar hashes de IP. Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 48
VOTE_SECRET=
# Máximo de votos por IP, por ranking e por período (redes compartilhadas: Wi-Fi, 4G com CGNAT…).
VOTE_IP_LIMIT_PER_PERIOD=20

# --- Administração (/admin) ---
# Senha do painel. Use uma senha longa.
ADMIN_PASSWORD=
# Segredo para assinar a sessão do painel. Mínimo de 32 caracteres (openssl rand -base64 48).
ADMIN_SESSION_SECRET=

# --- Conteúdo (opcional) ---
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@canaldobenjaoficial
NEXT_PUBLIC_CARICATURE_CREDIT=Caricaturas: Oberdan
